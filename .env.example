# Contact form (app/contact/actions.ts). Sending turns on only when all of
# RESEND_API_KEY, CONTACT_TO and CONTACT_FROM are set; otherwise /contact
# shows the form with a "not accepting submissions yet" notice and a
# disabled button.

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Where inquiries are delivered. Several addresses: separate with commas.
CONTACT_TO=info@example.com

# Sender address on a domain verified in Resend (required). Resend's shared
# onboarding@resend.dev only delivers to the Resend account owner, so it
# can't be used for real inquiries.
CONTACT_FROM=

# Public origin of the site (metadataBase, canonical URLs, sitemap, JSON-LD).
# Defaults to https://yuei-hp.vercel.app. Set it in Vercel production.
NEXT_PUBLIC_SITE_URL=
