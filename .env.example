# Contact form (app/contact/actions.ts). Sending turns on only when both
# RESEND_API_KEY and CONTACT_TO are set; otherwise /contact shows the form
# with a "not accepting submissions yet" notice and a disabled button.

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Where inquiries are delivered. Several addresses: separate with commas.
CONTACT_TO=info@example.com

# Sender address (a domain verified in Resend). Defaults to onboarding@resend.dev.
CONTACT_FROM=

# Public origin of the site (metadataBase, canonical URLs, sitemap, JSON-LD).
# Defaults to https://yuei-hp.vercel.app.
NEXT_PUBLIC_SITE_URL=
